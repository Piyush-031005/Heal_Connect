{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/_next/*",
      "/images/*",
      "/fonts/*",
      "/*.ico",
      "/*.png",
      "/*.svg",
      "/*.jpg",
      "/*.webp"
    ]
  },
  "globalHeaders": {
    "cache-control": "no-store"
  }
}
